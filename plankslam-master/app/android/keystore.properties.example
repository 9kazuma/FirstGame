# Copy this file to  android/keystore.properties  and fill in your real values.
# keystore.properties is gitignored - it must NEVER be committed.
#
# storeFile is resolved relative to android/app/
storeFile=plankslam-release-key.jks
keyAlias=plankslam
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
